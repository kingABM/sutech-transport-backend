PROJECT_NAME="SUtech Smart Transport"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL with PostGIS & pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sutech_transport_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sutech_transport_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sutech_transport_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_a_very_secret_key_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440